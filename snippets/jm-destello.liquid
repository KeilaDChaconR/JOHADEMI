{%- comment -%}
  jm-destello.liquid — destellos decorativos del sitio.
  {% render 'jm-destello', forma: 'estrella', clase: 'mi-clase' %}
  forma: estrella (rellena) | contorno | triangulo | tripunta
{%- endcomment -%}
{%- case forma -%}
  {%- when 'contorno' -%}
    <svg class="jm-destello {{ clase }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round" aria-hidden="true"><path d="M12 2c.8 5.2 3.9 8.3 9.5 10-5.6 1.7-8.7 4.8-9.5 10-.8-5.2-3.9-8.3-9.5-10C8.1 10.3 11.2 7.2 12 2z"/></svg>
  {%- when 'triangulo' -%}
    <svg class="jm-destello {{ clase }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true"><path d="M12 5.5 20 18.5H4z"/></svg>
  {%- when 'tripunta' -%}
    <svg class="jm-destello {{ clase }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" aria-hidden="true"><path d="M12 2.5c.7 6.5 3.4 11.4 9.5 17-6.4-2-12.6-2-19 0 6.1-5.6 8.8-10.5 9.5-17z"/></svg>
  {%- else -%}
    <svg class="jm-destello {{ clase }}" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 1c.9 5.6 4.4 9.1 11 11-6.6 1.9-10.1 5.4-11 11-.9-5.6-4.4-9.1-11-11 6.6-1.9 10.1-5.4 11-11z"/></svg>
{%- endcase -%}
