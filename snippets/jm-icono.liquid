{%- comment -%}
  jm-icono.liquid — íconos de línea.
  {% render 'jm-icono', icono: 'whatsapp' %}  (whatsapp | instagram | tiktok | bolsa | chevron | corazon)
{%- endcomment -%}
{%- case icono -%}
  {%- when 'whatsapp' -%}
    <svg class="jm-icono" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="{{ grosor | default: 2 }}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 21l1.65-3.8a9 9 0 1 1 3.4 2.9L3 21"/><path d="M9 10a.5.5 0 0 0 1 0V9a.5.5 0 0 0-1 0v1a5 5 0 0 0 5 5h1a.5.5 0 0 0 0-1h-1a.5.5 0 0 0 0 1"/></svg>
  {%- when 'instagram' -%}
    <svg class="jm-icono" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="{{ grosor | default: 2 }}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="4"/><circle cx="12" cy="12" r="3"/><path d="M16.5 7.5v.01"/></svg>
  {%- when 'tiktok' -%}
    <svg class="jm-icono" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="{{ grosor | default: 2 }}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 7.9v4a10 10 0 0 1-5-1.9v4.5a6.5 6.5 0 1 1-8-6.3v4.3a2.5 2.5 0 1 0 4 2V3h4.1A6 6 0 0 0 21 7.9z"/></svg>
  {%- when 'bolsa' -%}
    <svg class="jm-icono" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="{{ grosor | default: 2 }}" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6.3 8h11.4a2 2 0 0 1 2 2.3l-1.3 8.2a3 3 0 0 1-3 2.5H8.6a3 3 0 0 1-3-2.5l-1.3-8.2a2 2 0 0 1 2-2.3z"/><path d="M9 11V6a3 3 0 0 1 6 0v5"/></svg>
  {%- when 'chevron' -%}
    <svg class="jm-icono" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
  {%- when 'corazon' -%}
    <svg class="jm-icono" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19.5 12.6 12 20l-7.5-7.4A5 5 0 1 1 12 6a5 5 0 1 1 7.5 6.6z"/></svg>
{%- endcase -%}
