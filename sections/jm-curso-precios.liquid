<section class="jm-curso jm-curso-precios"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor | handleize }}"{% endif %}>
  <div class="jm-wrap">
    <div class="jm-curso__cabeza">
      {%- if section.settings.badge != blank -%}
        <p class="jm-curso__etiqueta jm-curso-precios__etiqueta">{{ section.settings.badge | escape }}</p>
      {%- endif -%}
      <h2 class="jm-curso__titulo">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}
        <div class="jm-texto jm-curso-precios__intro">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>

    <div class="jm-curso-precios__caja">
      {%- if section.blocks.size > 0 -%}
        <ul class="jm-curso-precios__lista">
          {%- for block in section.blocks -%}
            <li class="jm-curso__tarjeta jm-precio{% if block.settings.highlight %} jm-precio--destacado{% endif %}" {{ block.shopify_attributes }}>
              <p class="jm-precio__titulo">{{ block.settings.title | escape }}</p>
              {%- if block.settings.price != blank -%}<p class="jm-precio__valor">{{ block.settings.price | escape }}</p>{%- endif -%}
              {%- if block.settings.text != blank -%}<p class="jm-precio__texto">{{ block.settings.text | escape }}</p>{%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      <div class="jm-curso-precios__accion">
        {%- if section.settings.button_type == 'carrito' and product != blank -%}
          {%- if product.available -%}
            {%- form 'product', product -%}
              <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
              <button type="submit" class="jm-btn">{{ section.settings.button_label | escape }}</button>
            {%- endform -%}
            <p class="jm-curso-precios__monto">{{ product.price | money_without_trailing_zeros }}</p>
          {%- else -%}
            <span class="jm-btn jm-btn--agotado">Cupos agotados</span>
          {%- endif -%}
        {%- elsif section.settings.button_label != blank -%}
          <a class="jm-btn" href="{{ section.settings.button_url | default: '#' }}"{% if section.settings.button_url contains '://' %} target="_blank" rel="noopener"{% endif %}>{{ section.settings.button_label | escape }}</a>
        {%- endif -%}
        {%- if section.settings.note != blank -%}
          <p class="jm-curso-precios__nota">{{ section.settings.note | escape }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .jm-curso-precios__etiqueta { margin: 0 0 20px; }
  .jm-curso-precios__intro { margin-top: 16px; }
  .jm-curso-precios__caja { display: grid; gap: clamp(28px, 3vw, 40px); max-width: 960px; margin: 0 auto; }

  .jm-curso-precios__lista {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .jm-precio { display: grid; align-content: start; gap: 10px; padding: 28px 24px; text-align: center; color: #fff; }
  .jm-precio p { margin: 0; }
  .jm-precio__titulo { color: var(--jm-lima); font-weight: 800; font-size: 14px; letter-spacing: .06em; text-transform: uppercase; }
  .jm-precio__valor { font-weight: 800; font-size: clamp(24px, 2.4vw, 32px); letter-spacing: -0.03em; }
  .jm-precio__texto { font-size: 15px; line-height: 1.5; }
  .jm-precio--destacado { background: var(--jm-lima); border-color: var(--jm-lima); color: var(--jm-lila-texto); }
  .jm-precio--destacado .jm-precio__titulo { color: var(--jm-lila-texto); }

  .jm-curso-precios__accion { display: grid; justify-items: center; gap: 14px; text-align: center; }
  .jm-curso-precios__accion form { margin: 0; }
  .jm-curso-precios__monto { margin: 0; color: var(--jm-lima); font-weight: 800; font-size: 22px; }
  .jm-curso-precios__nota { max-width: 52ch; margin: 0; color: rgba(255, 255, 255, .85); font-size: 14px; line-height: 1.5; }
{% endstylesheet %}

{% schema %}
{
  "name": "JM · Curso: precios",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "badge", "label": "Etiqueta superior" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Únete a la lista de espera" },
    { "type": "richtext", "id": "text", "label": "Texto" },
    {
      "type": "select", "id": "button_type", "label": "Botón", "default": "enlace",
      "options": [
        { "value": "enlace", "label": "Enlace (lista de espera, WhatsApp…)" },
        { "value": "carrito", "label": "Comprar: añade este producto al carrito" }
      ]
    },
    { "type": "text", "id": "button_label", "label": "Texto del botón", "default": "Regístrate ahora" },
    { "type": "text", "id": "button_url", "label": "Enlace del botón", "info": "Solo si el botón es un enlace" },
    { "type": "textarea", "id": "note", "label": "Nota bajo el botón" },
    { "type": "text", "id": "anchor", "label": "Ancla", "default": "lista-espera", "info": "El botón de la portada apunta a #lista-espera" }
  ],
  "blocks": [
    {
      "type": "precio",
      "name": "Precio / etapa",
      "settings": [
        { "type": "text", "id": "title", "label": "Nombre", "default": "Lista de espera" },
        { "type": "text", "id": "price", "label": "Valor (opcional)", "info": "Ej: $250.000" },
        { "type": "textarea", "id": "text", "label": "Texto" },
        { "type": "checkbox", "id": "highlight", "label": "Destacar (fondo lima)", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "JM · Curso: precios",
      "blocks": [
        { "type": "precio", "settings": { "highlight": true } },
        { "type": "precio", "settings": { "title": "Precio final" } }
      ]
    }
  ]
}
{% endschema %}
