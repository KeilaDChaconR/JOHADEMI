{%- liquid
  assign n_fechas = 0
  for block in section.blocks
    if block.type == 'fecha'
      assign n_fechas = n_fechas | plus: 1
    endif
  endfor
-%}
<section class="jm-curso jm-curso-fechas"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor | handleize }}"{% endif %}>
  <div class="jm-wrap">
    <div class="jm-curso__cabeza">
      {%- if section.settings.eyebrow != blank -%}
        <p class="jm-curso__ceja">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h2 class="jm-curso__titulo">{{ section.settings.heading | escape }}</h2>
    </div>

    <div class="jm-curso-fechas__caja">
      {%- if n_fechas > 0 -%}
        <ul class="jm-curso-fechas__fechas" style="--jm-n: {{ n_fechas }};">
          {%- for block in section.blocks -%}
            {%- if block.type == 'fecha' -%}
              <li class="jm-curso__tarjeta jm-curso-fechas__item" {{ block.shopify_attributes }}>
                {%- if block.settings.icon != blank -%}<span class="jm-curso-fechas__icono" aria-hidden="true">{{ block.settings.icon }}</span>{%- endif -%}
                <span class="jm-curso-fechas__fecha">{{ block.settings.date | escape }}</span>
                {%- if block.settings.note != blank -%}<span class="jm-curso-fechas__nota">{{ block.settings.note | escape }}</span>{%- endif -%}
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}

      <ul class="jm-curso-fechas__datos">
        {%- for block in section.blocks -%}
          {%- if block.type == 'dato' -%}
            <li class="jm-curso__tarjeta jm-curso-fechas__item" {{ block.shopify_attributes }}>
              {%- if block.settings.icon != blank -%}<span class="jm-curso-fechas__icono" aria-hidden="true">{{ block.settings.icon }}</span>{%- endif -%}
              <strong class="jm-curso-fechas__fecha">{{ block.settings.title | escape }}</strong>
              {%- if block.settings.text != blank -%}<span class="jm-curso-fechas__nota">{{ block.settings.text | escape }}</span>{%- endif -%}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </div>
</section>

{% stylesheet %}
  .jm-curso-fechas__caja { display: grid; gap: clamp(20px, 2.4vw, 32px); max-width: 960px; margin: 0 auto; }
  .jm-curso-fechas__fechas,
  .jm-curso-fechas__datos { display: grid; gap: 14px; margin: 0; padding: 0; list-style: none; }
  .jm-curso-fechas__fechas { grid-template-columns: repeat(var(--jm-n, 5), minmax(0, 1fr)); }
  .jm-curso-fechas__datos { grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; }
  .jm-curso-fechas__datos:empty { display: none; }

  .jm-curso-fechas__item { display: grid; justify-items: center; align-content: start; gap: 6px; padding: 22px 12px; text-align: center; color: #fff; }
  .jm-curso-fechas__icono { font-size: 24px; line-height: 1; margin-bottom: 4px; }
  .jm-curso-fechas__fecha { color: var(--jm-lima); font-weight: 800; font-size: 16px; letter-spacing: -0.02em; text-transform: uppercase; }
  .jm-curso-fechas__nota { font-size: 14px; line-height: 1.4; }

  @media (max-width: 749px) {
    .jm-curso-fechas__fechas { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .jm-curso-fechas__fechas li:last-child:nth-child(odd) { grid-column: 1 / -1; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "JM · Curso: fechas",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño superior", "default": "Fechas y modalidad" },
    { "type": "text", "id": "heading", "label": "Título", "default": "5 semanas, cada miércoles" },
    { "type": "text", "id": "anchor", "label": "Ancla", "default": "fechas", "info": "El botón «Ver fechas» de la portada apunta a #fechas" }
  ],
  "blocks": [
    {
      "type": "fecha",
      "name": "Fecha",
      "settings": [
        { "type": "text", "id": "icon", "label": "Emoji", "default": "🌀" },
        { "type": "text", "id": "date", "label": "Fecha", "default": "Mié 4 nov" },
        { "type": "text", "id": "note", "label": "Nota (opcional)", "info": "Ej: Cierre" }
      ]
    },
    {
      "type": "dato",
      "name": "Dato (hora, lugar…)",
      "settings": [
        { "type": "text", "id": "icon", "label": "Emoji", "default": "🕖" },
        { "type": "text", "id": "title", "label": "Título", "default": "7:00 p.m." },
        { "type": "text", "id": "text", "label": "Texto", "default": "Hora Colombia" }
      ]
    }
  ],
  "presets": [
    {
      "name": "JM · Curso: fechas",
      "blocks": [
        { "type": "fecha" },
        { "type": "dato" }
      ]
    }
  ]
}
{% endschema %}
