<section class="jm-conoceme">
  <div class="jm-wrap jm-conoceme__caja">
    <h1 class="jm-titular jm-conoceme__titulo">{{ section.settings.heading | escape | newline_to_br }}</h1>

    <div class="jm-conoceme__grid">
      <div class="jm-texto jm-conoceme__texto">{{ section.settings.text }}</div>

      <div class="jm-conoceme__foto">
        <div class="jm-circulo">
          {%- if section.settings.image != blank -%}
            {{ section.settings.image | image_url: width: 1000 | image_tag: widths: '400, 700, 1000', sizes: '(min-width: 990px) 460px, 80vw', alt: section.settings.image.alt, loading: 'lazy' }}
          {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>
        {%- if section.settings.show_sparkles -%}
          {% render 'jm-destello', forma: 'estrella', clase: 'jm-conoceme__d1' %}
          {% render 'jm-destello', forma: 'contorno', clase: 'jm-conoceme__d2' %}
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .jm-conoceme { overflow-x: clip; }
  .jm-conoceme__caja {
    display: grid;
    gap: clamp(36px, 5vw, 80px);
    padding-top: clamp(36px, 5.5vw, 90px);
    padding-bottom: clamp(64px, 8vw, 120px);
  }
  .jm-conoceme__titulo { font-size: clamp(34px, 9vw, 150px); }

  .jm-conoceme__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, .8fr);
    gap: clamp(40px, 7vw, 130px);
    align-items: center;
  }
  .jm-conoceme__texto { max-width: 740px; text-align: justify; hyphens: auto; }

  .jm-conoceme__foto { position: relative; width: min(100%, 460px); justify-self: center; }
  .jm-conoceme__d1 { top: 12%; right: -9%; width: 22%; }
  .jm-conoceme__d2 { top: 33%; right: -17%; width: 14%; }

  @media (max-width: 989px) {
    .jm-conoceme__grid { grid-template-columns: minmax(0, 1fr); }
    .jm-conoceme__texto { text-align: left; }
    .jm-conoceme__foto { width: min(78%, 400px); }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "JM · Conóceme",
  "tag": "section",
  "settings": [
    { "type": "textarea", "id": "heading", "label": "Titular", "default": "Hola\n¡Conozcámonos!" },
    { "type": "richtext", "id": "text", "label": "Historia", "default": "<p>Soy Johanna Martinez, crecí en un hogar completamente disfuncional donde viví diferentes tipos de violencia y además crecí en un contexto de mucha pobreza. Mi historia es mucho más larga y profunda, historia que poco a poco si sigues mis redes podrás ir descubriendo donde entenderás cómo transformé estas experiencias a mi favor. Ahora me dedico a enseñar a otras personas sobrevivientes de traumas a transformar su vida tal y como yo lo sigo haciendo.</p><p>En mi vida, se generaron diversos traumas que afectaron mi salud física y emocional que desencadenaron enfermedades como la depresión, ansiedad, ataques de pánico y un proceso físico de enfermedad autoinmune.</p><p>Sin embargo, a los 27 años, ocurrió un despertar que cambió el rumbo de mi vida. Si bien ya estudiaba psicología, fue el encuentro con la medicina tradicional china.</p>" },
    { "type": "image_picker", "id": "image", "label": "Foto (se recorta en círculo)" },
    { "type": "checkbox", "id": "show_sparkles", "label": "Mostrar destellos", "default": true }
  ],
  "presets": [{ "name": "JM · Conóceme" }]
}
{% endschema %}
