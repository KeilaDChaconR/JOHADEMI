<div class="jm-header-wrap">
  <header class="jm-header jm-wrap" data-jm-header style="--jm-logo-w: {{ section.settings.logo_width }}px;">
    <a class="jm-logo" href="{{ routes.root_url }}">
      {%- if section.settings.logo != blank -%}
        {{ section.settings.logo | image_url: width: 700 | image_tag: alt: shop.name, class: 'jm-logo__img', widths: '350, 700', sizes: '330px' }}
      {%- else -%}
        <span class="jm-logo__txt">{{ shop.name | upcase }}</span>
        <span class="jm-logo__url">JOHADEMI.COM</span>
      {%- endif -%}
    </a>

    <nav class="jm-nav" id="JmNav-{{ section.id }}" aria-label="Principal">
      <ul class="jm-nav__lista">
        {%- for link in section.settings.menu.links -%}
          {%- if link.links != blank -%}
            <li class="jm-nav__item jm-nav__item--sub">
              <a href="{{ link.url }}" class="jm-nav__link{% if link.active or link.child_active %} is-activo{% endif %}">{{ link.title | escape }}</a>
              <button type="button" class="jm-nav__chev" aria-expanded="false" aria-label="Abrir {{ link.title | escape }}" data-jm-sub>{% render 'jm-icono', icono: 'chevron' %}</button>
              <ul class="jm-sub">
                {%- for child in link.links -%}
                  <li><a href="{{ child.url }}" class="jm-sub__link{% if child.active %} is-activo{% endif %}">{{ child.title | escape }}</a></li>
                {%- endfor -%}
              </ul>
            </li>
          {%- else -%}
            <li class="jm-nav__item">
              <a href="{{ link.url }}" class="jm-nav__link{% if link.active %} is-activo{% endif %}">{{ link.title | escape }}</a>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
      {%- if section.settings.cta_label != blank -%}
        <a class="jm-btn jm-header__cta" href="{{ section.settings.cta_url | default: '#' }}">{{ section.settings.cta_label | escape }}</a>
      {%- endif -%}
    </nav>

    <div class="jm-header__acciones">
      {%- if section.settings.show_cart -%}
        <a href="{{ routes.cart_url }}" class="jm-carrito" aria-label="Carrito ({{ cart.item_count }})">
          {% render 'jm-icono', icono: 'bolsa' %}
          {%- if cart.item_count > 0 -%}<span class="jm-carrito__n">{{ cart.item_count }}</span>{%- endif -%}
        </a>
      {%- endif -%}
      <button class="jm-burger" type="button" aria-expanded="false" aria-controls="JmNav-{{ section.id }}" data-jm-toggle>
        <span></span><span></span><span></span>
        <span class="visually-hidden">Menú</span>
      </button>
    </div>
  </header>
</div>

<script>
  (() => {
    const h = document.querySelector('#shopify-section-{{ section.id }} [data-jm-header]');
    if (!h) return;
    h.querySelector('[data-jm-toggle]').addEventListener('click', (e) => {
      const abierto = h.classList.toggle('is-abierto');
      e.currentTarget.setAttribute('aria-expanded', abierto);
    });
    h.querySelectorAll('[data-jm-sub]').forEach((b) => b.addEventListener('click', () => {
      const li = b.closest('li');
      const abierto = li.classList.toggle('is-abierto');
      b.setAttribute('aria-expanded', abierto);
    }));
  })();
</script>

{% stylesheet %}
  .jm-header-wrap { position: relative; z-index: 20; }

  .jm-header {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-top: 22px;
    padding-bottom: 22px;
  }

  .jm-logo { display: grid; flex: 0 0 auto; color: var(--jm-lima); text-decoration: none; }
  .jm-logo__img { display: block; width: min(var(--jm-logo-w), 58vw); height: auto; }

  .jm-nav { display: flex; align-items: center; gap: clamp(20px, 2.4vw, 40px); }
  .jm-nav__lista { display: flex; align-items: center; gap: clamp(14px, 1.9vw, 34px); margin: 0; padding: 0; list-style: none; }
  .jm-nav__item { position: relative; display: flex; align-items: center; gap: 2px; }

  .jm-nav__link {
    padding: 10px 0;
    color: var(--jm-lima);
    font-weight: 700;
    font-size: 16px;
    letter-spacing: -0.035em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    transition: color .2s;
  }
  .jm-nav__link:hover { color: #fff; }
  .jm-nav__link.is-activo { color: var(--jm-lima-activo); }

  .jm-nav__chev {
    display: grid;
    place-items: center;
    width: 26px;
    height: 32px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--jm-lima);
    cursor: pointer;
  }
  .jm-nav__chev .jm-icono { width: 12px; height: 12px; transition: transform .2s; }

  .jm-sub {
    position: absolute;
    top: 100%;
    left: -18px;
    min-width: 240px;
    margin: 0;
    padding: 10px 0;
    list-style: none;
    background: var(--jm-lila-oscuro);
    box-shadow: 0 18px 40px rgba(60, 30, 110, .25);
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition: opacity .2s, transform .2s, visibility .2s;
  }
  .jm-nav__item--sub:hover .jm-sub,
  .jm-nav__item--sub:focus-within .jm-sub,
  .jm-nav__item.is-abierto .jm-sub { opacity: 1; visibility: visible; transform: none; }

  .jm-sub__link {
    display: block;
    padding: 11px 20px;
    color: #fff;
    font-weight: 600;
    font-size: 15px;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    text-decoration: none;
  }
  .jm-sub__link:hover, .jm-sub__link.is-activo { color: var(--jm-lima); }

  .jm-header__cta { min-height: 56px; padding: 0 28px; font-size: 17px; }

  .jm-header__acciones { display: flex; align-items: center; gap: 4px; }
  .jm-carrito { position: relative; display: grid; place-items: center; width: 44px; height: 44px; color: var(--jm-lima); }
  .jm-carrito .jm-icono { width: 26px; height: 26px; }
  .jm-carrito__n {
    position: absolute;
    top: 3px;
    right: 1px;
    min-width: 18px;
    height: 18px;
    padding: 0 4px;
    border-radius: 9px;
    display: grid;
    place-items: center;
    background: #fff;
    color: var(--jm-lila-oscuro);
    font-size: 11px;
    font-weight: 700;
  }

  .jm-burger { display: none; }

  @media (max-width: 1199px) {
    .jm-burger {
      display: grid;
      place-content: center;
      gap: 5px;
      width: 44px;
      height: 44px;
      padding: 0;
      border: 0;
      background: none;
      cursor: pointer;
    }
    .jm-burger span:not(.visually-hidden) { display: block; width: 26px; height: 3px; background: var(--jm-lima); transition: transform .2s, opacity .2s; }
    .jm-header.is-abierto .jm-burger span:nth-child(1) { transform: translateY(8px) rotate(45deg); }
    .jm-header.is-abierto .jm-burger span:nth-child(2) { opacity: 0; }
    .jm-header.is-abierto .jm-burger span:nth-child(3) { transform: translateY(-8px) rotate(-45deg); }

    .jm-nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      display: none;
      flex-direction: column;
      align-items: stretch;
      gap: 24px;
      max-height: calc(100vh - 100px);
      overflow-y: auto;
      padding: 8px var(--jm-margen) 32px;
      background: var(--jm-lila-oscuro);
      box-shadow: 0 24px 40px rgba(60, 30, 110, .25);
    }
    .jm-header.is-abierto .jm-nav { display: flex; }

    .jm-nav__lista { flex-direction: column; align-items: stretch; gap: 0; }
    .jm-nav__item { flex-wrap: wrap; justify-content: space-between; border-bottom: 1px solid rgba(230, 248, 92, .25); }
    .jm-nav__link { padding: 14px 0; font-size: 20px; }
    .jm-nav__chev { width: 44px; height: 44px; }
    .jm-nav__item.is-abierto .jm-nav__chev .jm-icono { transform: rotate(180deg); }

    .jm-sub {
      position: static;
      flex-basis: 100%;
      display: none;
      min-width: 0;
      padding: 0 0 12px 12px;
      background: none;
      box-shadow: none;
      opacity: 1;
      visibility: visible;
      transform: none;
    }
    .jm-nav__item.is-abierto .jm-sub { display: block; }
    .jm-sub__link { padding: 10px 0; font-size: 16px; }

    .jm-header__cta { align-self: flex-start; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "JM · Encabezado",
  "tag": "section",
  "enabled_on": { "groups": ["header"] },
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo (versión lima)" },
    { "type": "range", "id": "logo_width", "label": "Ancho del logo", "min": 160, "max": 400, "step": 10, "unit": "px", "default": 330 },
    { "type": "link_list", "id": "menu", "label": "Menú", "default": "main-menu" },
    { "type": "text", "id": "cta_label", "label": "Texto del botón", "default": "Contáctame" },
    { "type": "url", "id": "cta_url", "label": "Enlace del botón" },
    { "type": "checkbox", "id": "show_cart", "label": "Mostrar ícono del carrito", "default": true }
  ]
}
{% endschema %}
